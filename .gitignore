# Runtime data and local state.  Never committed: a clone must not inherit
# another machine's library, credentials or cache.
data/
*.sqlite3
*.sqlite3-*
*.db

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
build/
dist/

# Secrets and machine-specific configuration
*.key
*.crt
*.pem
certs/
*.local.json
agent-env.json
plugins.json
remote-access.json

# Scratch
tmp/
_scratch/
*.log
